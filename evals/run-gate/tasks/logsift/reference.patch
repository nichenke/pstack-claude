+++ b/logsift/config.py
@@ -0,0 +1,30 @@
+import tomllib
+from pathlib import Path
+
+DEFAULT_NAME = "logsift.toml"
+KEYS = ("by", "format", "min_level")
+
+
+class ConfigError(Exception):
+    pass
+
+
+def load_config(path=None):
+    """Defaults from the TOML file at `path`, or from ./logsift.toml when `path` is None.
+
+    A missing ./logsift.toml gives {}; a missing explicit `path`, bad TOML, or an unknown key raises ConfigError.
+    """
+    explicit = path is not None
+    path = Path(path) if explicit else Path(DEFAULT_NAME)
+    if not path.is_file():
+        if explicit:
+            raise ConfigError(f"config file {path} does not exist")
+        return {}
+    try:
+        data = tomllib.loads(path.read_text(encoding="utf-8"))
+    except tomllib.TOMLDecodeError as error:
+        raise ConfigError(f"{path}: {error}") from error
+    unknown = sorted(set(data) - set(KEYS))
+    if unknown:
+        raise ConfigError(f"{path}: unknown keys {', '.join(unknown)}")
+    return data
