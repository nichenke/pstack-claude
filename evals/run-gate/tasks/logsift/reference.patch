@@ -0,0 +1,36 @@
+import re
+from datetime import datetime, timedelta, timezone
+
+from logsift.parse import LEVELS, normalize_level, parse_timestamp
+
+DURATION = re.compile(r"^(\d+)([smhd])$")
+UNITS = {"s": "seconds", "m": "minutes", "h": "hours", "d": "days"}
+
+
+def parse_bound(text, now=None):
+    """An ISO 8601 timestamp, or a duration such as 30m counted back from `now`, as an aware datetime.
+
+    Raises ValueError for anything else.
+    """
+    match = DURATION.match(text)
+    if match:
+        now = now or datetime.now(timezone.utc)
+        return now - timedelta(**{UNITS[match[2]]: int(match[1])})
+    return parse_timestamp(text)
+
+
+def parse_level(text):
+    """The canonical level for `text`; raises ValueError when it names none."""
+    level = normalize_level(text)
+    if level is None:
+        raise ValueError(f"unknown level {text!r}; expected one of {', '.join(LEVELS)}")
+    return level
+
+
+def keep(record, since=None, until=None, min_level=None):
+    """Whether `record` falls in [since, until) and is at or above `min_level`."""
+    if since is not None and record.timestamp < since:
+        return False
+    if until is not None and record.timestamp >= until:
+        return False
+    return min_level is None or LEVELS.index(record.level) >= LEVELS.index(min_level)
