+++ b/logsift/output.py
@@ -0,0 +1,18 @@
+import csv
+import io
+import json
+
+FORMATS = ("table", "json", "csv")
+
+
+def render(counts, fmt="table"):
+    """The text for (key, count) pairs in `fmt`, ending in a newline unless it is an empty table."""
+    if fmt == "json":
+        return json.dumps([{"key": key, "count": count} for key, count in counts]) + "\n"
+    if fmt == "csv":
+        buffer = io.StringIO()
+        writer = csv.writer(buffer, lineterminator="\n")
+        writer.writerow(["key", "count"])
+        writer.writerows(counts)
+        return buffer.getvalue()
+    return "".join(f"{key} {count}\n" for key, count in counts)
